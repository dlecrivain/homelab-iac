{
  "title": "Disk wear",
  "uid": "disk-wear",
  "tags": [
    "disks",
    "homelab"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5m",
  "time": {
    "from": "now-90d",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Disk wear and estimated end of life",
      "description": "Wear used is the worst of the drive's own figure, the share of its rated endurance already written (NVMe) and 100 minus its wear attribute (SATA), from roles/prometheus_configure/templates/disk_wear.rules.yml.j2. The first end-of-life estimate extends the average wear per powered-on hour since the drive was new; the second extends the write rate of the last 30 days and exists for NVMe only. Each is the date followed by the time left, so the column sorts chronologically. SATA drives report wear in whole percent, so their dates are coarse. The rated endurance is the manufacturer's figure (disk_rated_endurance_tbw).",
      "gridPos": {
        "h": 11,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (instance, device) (disk:wear_used_percent)",
          "refId": "A",
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (instance, device) (smartctl_device_power_on_seconds)",
          "refId": "B",
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (instance, device) (label_replace(increase(node_disk_written_bytes_total{role=\"pve_node\", device=~\"sd[a-z]|nvme[0-9]+n[0-9]+\"}[30d]), \"device\", \"$1\", \"device\", \"(nvme[0-9]+)n[0-9]+\"))",
          "refId": "C",
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (instance, device, eol_avg) (label_join(label_join(label_replace(label_replace(label_replace(label_replace(label_replace(count_values by (instance, device) (\"yr\", year(disk:wear_end_timestamp_seconds)) * on (instance, device) group_left (mo) count_values by (instance, device) (\"mo\", month(disk:wear_end_timestamp_seconds)) * on (instance, device) group_left (da) count_values by (instance, device) (\"da\", day_of_month(disk:wear_end_timestamp_seconds)) * on (instance, device) group_left (years) count_values by (instance, device) (\"years\", floor((disk:wear_end_timestamp_seconds - time()) / 31557600)) * on (instance, device) group_left (days) count_values by (instance, device) (\"days\", floor(((disk:wear_end_timestamp_seconds - time()) % 31557600) / 86400)), \"mo\", \"0$1\", \"mo\", \"^([0-9])$\"), \"da\", \"0$1\", \"da\", \"^([0-9])$\"), \"open\", \" (\", \"\", \"\"), \"year_unit\", \"y \", \"\", \"\"), \"close\", \"d)\", \"\", \"\"), \"date\", \"-\", \"yr\", \"mo\", \"da\"), \"eol_avg\", \"\", \"date\", \"open\", \"years\", \"year_unit\", \"days\", \"close\"))",
          "refId": "D",
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (instance, device, eol_recent) (label_join(label_join(label_replace(label_replace(label_replace(label_replace(label_replace(count_values by (instance, device) (\"yr\", year(disk:wear_end_timestamp_recent_seconds)) * on (instance, device) group_left (mo) count_values by (instance, device) (\"mo\", month(disk:wear_end_timestamp_recent_seconds)) * on (instance, device) group_left (da) count_values by (instance, device) (\"da\", day_of_month(disk:wear_end_timestamp_recent_seconds)) * on (instance, device) group_left (years) count_values by (instance, device) (\"years\", floor((disk:wear_end_timestamp_recent_seconds - time()) / 31557600)) * on (instance, device) group_left (days) count_values by (instance, device) (\"days\", floor(((disk:wear_end_timestamp_recent_seconds - time()) % 31557600) / 86400)), \"mo\", \"0$1\", \"mo\", \"^([0-9])$\"), \"da\", \"0$1\", \"da\", \"^([0-9])$\"), \"open\", \" (\", \"\", \"\"), \"year_unit\", \"y \", \"\", \"\"), \"close\", \"d)\", \"\", \"\"), \"date\", \"-\", \"yr\", \"mo\", \"da\"), \"eol_recent\", \"\", \"date\", \"open\", \"years\", \"year_unit\", \"days\", \"close\"))",
          "refId": "E",
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (instance, device, model_name) (smartctl_device)",
          "refId": "F",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value #D": true,
              "Value #E": true,
              "Value #F": true
            },
            "indexByName": {
              "instance": 0,
              "device": 1,
              "model_name": 2,
              "Value #A": 3,
              "Value #B": 4,
              "Value #C": 5,
              "eol_avg": 6,
              "eol_recent": 7
            },
            "renameByName": {
              "instance": "Node",
              "device": "Disk",
              "model_name": "Model",
              "Value #A": "Wear used",
              "Value #B": "Powered on",
              "Value #C": "Written (30 d)",
              "eol_avg": "End of life (average wear rate)",
              "eol_recent": "End of life (30-day write rate)"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "Node"
              },
              {
                "field": "Disk"
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Wear used"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 50
                    },
                    {
                      "color": "red",
                      "value": 80
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Powered on"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Written (30 d)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "decbytes"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          }
        ]
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "NVMe wear reported by the drive",
      "description": "percentage_used from the NVMe health log. Whole percent, so it moves in steps.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 11
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (instance, device) (smartctl_device_percentage_used)",
          "refId": "A",
          "range": true,
          "legendFormat": "{{instance}} {{device}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "NVMe data written",
      "description": "Host writes since the drive was new.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 11
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (instance, device) (smartctl_device_bytes_written)",
          "refId": "A",
          "range": true,
          "legendFormat": "{{instance}} {{device}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "decbytes",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Write rate per disk",
      "description": "Average over one hour, from node_exporter.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (instance, device) (rate(node_disk_written_bytes_total{role=\"pve_node\", device=~\"sd[a-z]|nvme[0-9]+n[0-9]+\"}[1h]))",
          "refId": "A",
          "range": true,
          "legendFormat": "{{instance}} {{device}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ]
}
