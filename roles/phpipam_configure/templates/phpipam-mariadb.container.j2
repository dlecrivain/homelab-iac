[Unit]
Description=phpIPAM MariaDB

[Container]
Image=docker.io/mariadb:{{ mariadb_version }}
ContainerName=phpipam-mariadb
Environment=MYSQL_ROOT_PASSWORD={{ phpipam_db_root_password }}
Volume=/var/phpipam/mysql-data:/var/lib/mysql:Z
Network=phpipam.network
# This unit's ExecStop is "podman rm -f" (Quadlet's own choice for a --rm container), which
# defaults to a 10s wait before SIGKILL - shorter than InnoDB can need to flush its buffer pool and
# tc.log cleanly, causing "Bad magic header in tc log" crash-recovery failures on the next start
# (hit three times: 22/08, and twice on 27/08). StopTimeout= (equivalent to the Podman
# --stop-timeout option per man podman-systemd.unit) sets that wait on the container itself at
# creation time - confirmed with two clean back-to-back `systemctl restart` cycles after applying
# it live. Note: applying this to an *already-running* container that predates the change doesn't
# help - stopping that old instance during the same restart that deploys the fix still uses
# whatever stop behavior it was originally created with. Kept well under systemd's own 90s
# TimeoutStopSec so systemd never races ahead of it.
StopTimeout=60

[Service]
Restart=always

[Install]
WantedBy=multi-user.target default.target
