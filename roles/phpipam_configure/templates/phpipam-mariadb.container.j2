[Unit]
Description=phpIPAM MariaDB

[Container]
Image=docker.io/mariadb:{{ mariadb_version }}
ContainerName=phpipam-mariadb
Environment=MYSQL_ROOT_PASSWORD={{ phpipam_db_root_password }}
Volume=/var/phpipam/mysql-data:/var/lib/mysql:Z
Network=phpipam.network
# A longer stop timeout, and skipping the buffer-pool dump/load, keep shutdown short enough to
# complete cleanly. See also ExecStartPre below, which removes tc.log.
StopTimeout=60
Exec=--innodb-buffer-pool-dump-at-shutdown=0 --innodb-buffer-pool-load-at-startup=0

[Service]
# tc.log exists only to resolve in-doubt two-phase-commit transactions after a crash. phpIPAM never
# issues XA transactions, so removing it before each start avoids recovery from a stale copy.
ExecStartPre=/bin/rm -f /var/phpipam/mysql-data/tc.log
Restart=always

[Install]
WantedBy=multi-user.target default.target
