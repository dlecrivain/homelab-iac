[Unit]
Description=Postgres {{ pg.name }}

[Container]
Image={{ pg.image }}
ContainerName=postgres_{{ pg.name }}
EnvironmentFile={{ postgres_root }}/{{ pg.name }}.env
Volume={{ postgres_root }}/{{ pg.name }}/data:/var/lib/postgresql/data:Z
PublishPort={{ pg.port }}:5432
HealthCmd=pg_isready -U {{ pg.user }} -d {{ pg.database }}
HealthInterval=30s

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
