global:
  scrape_interval: 30s
  evaluation_interval: 30s

rule_files:
  - /etc/prometheus/alert_rules.yml

alerting:
  alertmanagers:
    # Container name, not 127.0.0.1/localhost: each Quadlet container gets its own network
    # namespace by default, so "localhost" from inside Prometheus's container only ever
    # reaches itself. monitoring-network.network (shared by all 3 containers) gives DNS
    # resolution by container name instead - the same pattern semaphore_provision already
    # uses for semaphore -> semaphore_db.
    - static_configs:
        - targets: ["alertmanager:9093"]

scrape_configs:
  - job_name: prometheus
    static_configs:
      # 127.0.0.1 is correct here specifically because this is Prometheus scraping itself.
      - targets: ["127.0.0.1:9090"]

  - job_name: pve_exporter
    metrics_path: /pve
    params:
      cluster: ["1"]
      node: ["1"]
      target: ["{{ proxmox_api_host }}"]
    static_configs:
      - targets: ["pve-exporter:9221"]

  - job_name: node_exporter
    file_sd_configs:
      - files:
          - /etc/prometheus/file_sd/node_exporter_targets.d/*.json

  - job_name: smartctl_exporter
    file_sd_configs:
      - files:
          - /etc/prometheus/file_sd/smartctl_exporter_targets.d/*.json
