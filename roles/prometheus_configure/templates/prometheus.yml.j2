global:
  scrape_interval: 30s
  evaluation_interval: 30s

rule_files:
  - /etc/prometheus/alert_rules.yml

alerting:
  alertmanagers:
    - static_configs:
        - targets: ["localhost:9093"]

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ["localhost:9090"]

  - job_name: pve_exporter
    metrics_path: /pve
    params:
      cluster: ["1"]
      node: ["1"]
      target: ["{{ proxmox_api_host }}"]
    static_configs:
      - targets: ["localhost:9221"]

  - job_name: node_exporter
    file_sd_configs:
      - files:
          - /etc/prometheus/file_sd/node_exporter_targets.d/*.json

  - job_name: smartctl_exporter
    file_sd_configs:
      - files:
          - /etc/prometheus/file_sd/smartctl_exporter_targets.d/*.json
