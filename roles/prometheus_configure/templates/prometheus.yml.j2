global:
  scrape_interval: 30s
  evaluation_interval: 30s

rule_files:
  - /etc/prometheus/alert_rules.yml
  - /etc/prometheus/disk_wear.rules.yml

alerting:
  alertmanagers:
    # Container name, not 127.0.0.1/localhost: each Quadlet container gets its own network
    # namespace by default, so "localhost" from inside Prometheus's container only ever
    # reaches itself. monitoring-network.network (shared by all 3 containers) gives DNS
    # resolution by container name instead - the same pattern semaphore_provision already
    # uses for semaphore -> semaphore_db.
    - static_configs:
        - targets: ["alertmanager:9093"]

scrape_configs:
  - job_name: prometheus
    static_configs:
      # 127.0.0.1 is correct here specifically because this is Prometheus scraping itself.
      - targets: ["127.0.0.1:9090"]

  - job_name: pve_exporter
    metrics_path: /pve
    params:
      cluster: ["1"]
      node: ["1"]
      target: ["{{ proxmox_api_host }}"]
    static_configs:
      - targets: ["pve-exporter:9221"]

  - job_name: node_exporter
    file_sd_configs:
      - files:
          - /etc/prometheus/file_sd/node_exporter_targets.d/*.json

  - job_name: smartctl_exporter
    file_sd_configs:
      - files:
          - /etc/prometheus/file_sd/smartctl_exporter_targets.d/*.json

  # blackbox-exporter makes the request itself and reports whether it worked, the lifetime of the certificate and the
  # time it took. The target of a probe is the address that is checked, the scrape goes to the exporter.
  - job_name: blackbox_http
    metrics_path: /probe
    scrape_interval: 60s
    params:
      module: [http_2xx]
    static_configs:
{% for t in blackbox_http_targets %}
      - targets: ["{{ t.url }}"]
        labels:
          service: {{ t.name }}
{% endfor %}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: blackbox-exporter:9115

  - job_name: blackbox_tcp
    metrics_path: /probe
    scrape_interval: 60s
    params:
      module: [tcp_connect]
    static_configs:
{% for t in blackbox_tcp_targets %}
      - targets: ["{{ t.address }}"]
        labels:
          service: {{ t.name }}
{% endfor %}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: blackbox-exporter:9115
