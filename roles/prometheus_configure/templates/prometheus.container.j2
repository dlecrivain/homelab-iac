[Unit]
Description=Prometheus
Wants=network-online.target
After=network-online.target

[Container]
ContainerName=prometheus
Image=docker.io/prom/prometheus:{{ prometheus_version }}
Network=monitoring-network.network
Volume=/etc/prometheus:/etc/prometheus:Z,ro
Volume=prometheus_data.volume:/prometheus:Z
PublishPort=9090:9090
Exec=--config.file=/etc/prometheus/prometheus.yml --storage.tsdb.path=/prometheus --storage.tsdb.retention.time=30d

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
