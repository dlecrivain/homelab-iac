[Unit]
Description=Prometheus Blackbox Exporter
Wants=network-online.target
After=network-online.target

[Container]
ContainerName=blackbox-exporter
Image=docker.io/prom/blackbox-exporter:{{ blackbox_exporter_version }}
Network=monitoring-network.network
Volume=/etc/blackbox:/etc/blackbox_exporter:Z,ro
Exec=--config.file=/etc/blackbox_exporter/config.yml

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
