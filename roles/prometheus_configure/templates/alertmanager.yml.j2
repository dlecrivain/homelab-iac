route:
  group_by: ['alertname', 'instance']
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  receiver: email
  routes:
    # The cluster of tests is stopped by the Semaphore schedules Kubernetes-Stop (Friday 04:30) and Kubernetes-Start
    # (Friday 09:30): its alerts wait until the end of that window and are sent after it if the target still does not answer.
    - matchers:
        - window="kubernetes"
      receiver: email
      mute_time_intervals:
        - kubernetes-stopped

time_intervals:
  - name: kubernetes-stopped
    time_intervals:
      - weekdays: ['friday']
        times:
          - start_time: '04:25'
            end_time: '10:00'
        location: Europe/Paris

receivers:
  - name: email
    email_configs:
      - to: "{{ notify_email_to }}"
        from: "{{ smtp_user }}"
        smarthost: "{{ smtp_host }}:{{ smtp_port }}"
        auth_username: "{{ smtp_user }}"
        auth_password: "{{ smtp_password }}"
        require_tls: true
