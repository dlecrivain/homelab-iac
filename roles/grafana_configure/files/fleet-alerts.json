{
  "title": "Fleet Alerts",
  "uid": "fleet-alerts",
  "tags": ["alerts", "homelab"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Active alerts (warning and above)",
      "description": "Every currently pending or firing alert from roles/prometheus_configure/files/alert_rules.yml at severity warning or critical. Empty table = fleet healthy.",
      "gridPos": { "h": 16, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "ALERTS{severity=~\"warning|critical\"}",
          "instant": true,
          "format": "table",
          "refId": "A"
        }
      ],
      "transformations": [
        { "id": "labelsToFields", "options": {} },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "job": true
            },
            "indexByName": {
              "severity": 0,
              "alertstate": 1,
              "alertname": 2,
              "instance": 3
            },
            "renameByName": {
              "severity": "Severity",
              "alertstate": "State",
              "alertname": "Alert",
              "instance": "Instance",
              "device": "Device",
              "mountpoint": "Mountpoint",
              "name": "Unit",
              "id": "Storage"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [{ "field": "Severity", "desc": true }]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left",
            "cellOptions": { "type": "auto" },
            "filterable": true
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Severity" },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": { "type": "color-background", "mode": "basic" }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "critical": { "color": "red", "index": 0 },
                      "warning": { "color": "orange", "index": 1 }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "State" },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": { "type": "color-background", "mode": "basic" }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "firing": { "color": "dark-red", "index": 0 },
                      "pending": { "color": "yellow", "index": 1 }
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    }
  ]
}
