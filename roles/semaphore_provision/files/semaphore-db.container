[Unit]
Description=Semaphore Postgres DB
After=network-online.target
Wants=network-online.target

[Container]
Image=docker.io/library/postgres:16
ContainerName=semaphore_db
Network=semaphore-network.network
Volume=semaphore_postgres.volume:/var/lib/postgresql/data:Z
EnvironmentFile=/etc/semaphore/db.env

[Service]
Restart=on-failure
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
