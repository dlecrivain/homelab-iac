[Unit]
Description=Semaphore Postgres DB
After=network-online.target
Wants=network-online.target

[Container]
Image=docker.io/library/postgres:18
ContainerName=semaphore_db
Network=semaphore-network.network
# From Postgres 18 the image keeps its cluster in /var/lib/postgresql/<major>/docker, so the volume is mounted one level up.
Volume=semaphore_postgres18.volume:/var/lib/postgresql:Z
EnvironmentFile=/etc/semaphore/db.env

[Service]
Restart=on-failure
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
