#!/bin/sh
# Syntax-checks every playbook before anything leaves this clone.
cd "$(git rev-parse --show-toplevel)" || exit 1
status=0
for playbook in *.yml; do
  if ! output=$(LC_ALL=C.UTF-8 ansible-playbook --syntax-check -i localhost, "$playbook" 2>&1); then
    echo "pre-push: syntax check failed for $playbook" >&2
    echo "$output" >&2
    status=1
  fi
done
exit $status
