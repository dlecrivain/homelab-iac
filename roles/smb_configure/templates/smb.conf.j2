# Managed by the smb_configure role.
[global]
    server string = {{ inventory_hostname }}
    workgroup = {{ smb_workgroup }}
    netbios name = {{ smb_netbios_name }}
    server role = standalone server
    security = user
    map to guest = Never
    restrict anonymous = 2
    server min protocol = {{ smb_min_protocol }}
    # The NetBIOS name service is how some devices find the server.
    disable netbios = no
    hosts allow = 127.0.0.1 {{ smb_allowed_hosts | join(' ') }}
    hosts deny = ALL
    load printers = no
    printing = bsd
    printcap name = /dev/null
    disable spoolss = yes
    log file = /var/log/samba/log.%m
    max log size = 1000
    log level = 1

[{{ smb_share_name }}]
    path = {{ smb_share_path }}
    browseable = yes
    read only = no
    guest ok = no
    valid users = {{ smb_writer_user }} {{ smb_reader_user }}
    write list = {{ smb_writer_user }}
    force group = {{ smb_group }}
    create mask = 0660
    directory mask = 2770
