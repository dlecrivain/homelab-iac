#!/usr/bin/env bash
# Minimal client for the Semaphore API: list templates, start a task, wait for it, read its output.
#
#   semaphore-ctl templates
#   semaphore-ctl recent [N]
#   semaphore-ctl run <template-id> [--var name=value]... [--args '<json array>'] [--why '<text>']
#   semaphore-ctl status <task-id>
#   semaphore-ctl wait <task-id> [timeout-seconds]
#   semaphore-ctl log <task-id> [--errors | --tail N]
#   semaphore-ctl schedules
#   semaphore-ctl copy-template <source-id> <name> <playbook> [--dry-run]
#   semaphore-ctl add-schedule <template-id> '<cron>' <name> [--dry-run]
#   semaphore-ctl set-schedule <schedule-id> '<cron>' [--dry-run]
#   semaphore-ctl delete-schedule <schedule-id> [--dry-run]
#   semaphore-ctl delete-template <template-id> [--dry-run]
#   semaphore-ctl rename-template <template-id> <name> [--dry-run]
#   semaphore-ctl rename-schedule <schedule-id> <name> [--dry-run]
#   semaphore-ctl environments
#   semaphore-ctl delete-env-secret <environment-id> <name> [--dry-run]
#
# The API token is read from a file that nobody else may read, and is handed to curl through a
# config descriptor so it never appears on a command line. Starting a task is limited to the
# template ids listed in an allowlist file (one id per line, '#' starts a comment, a line with just
# '*' allows every template); without that file nothing can be started, while reading stays available.
set -euo pipefail

SEMAPHORE_URL=${SEMAPHORE_URL:-http://192.168.1.119:3000}
SEMAPHORE_PROJECT=${SEMAPHORE_PROJECT:-1}
CONFIG_DIR=${SEMAPHORE_CONFIG_DIR:-$HOME/.config/semaphore}
TOKEN_FILE=${SEMAPHORE_TOKEN_FILE:-$CONFIG_DIR/semaphore.token}
ALLOW_FILE=${SEMAPHORE_ALLOW_FILE:-$CONFIG_DIR/allowed-templates}
REPO_ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)

die() { echo "semaphore-ctl: $*" >&2; exit 1; }

[ -f "$TOKEN_FILE" ] || die "token file $TOKEN_FILE not found"
case "$(stat -c %a "$TOKEN_FILE")" in 400|600) ;; *) die "$TOKEN_FILE must be mode 600" ;; esac

auth_header() { printf 'header = "Authorization: Bearer %s"\n' "$(tr -d '[:space:]' < "$TOKEN_FILE")"; }

# api METHOD PATH [JSON-BODY] - prints the response body, fails on a non-2xx status.
api() {
  local out code
  if [ -n "${3:-}" ]; then
    out=$(curl -sS -m 30 -X "$1" -H 'Content-Type: application/json' -d "$3" -w '\n%{http_code}' -K <(auth_header) "$SEMAPHORE_URL$2")
  else
    out=$(curl -sS -m 30 -X "$1" -w '\n%{http_code}' -K <(auth_header) "$SEMAPHORE_URL$2")
  fi
  code=${out##*$'\n'}
  out=${out%$'\n'*}
  case "$code" in 2??) printf '%s\n' "$out" ;; *) die "HTTP $code from $2: ${out:0:300}" ;; esac
}

allowed_ids() { [ -f "$ALLOW_FILE" ] && sed 's/#.*//' "$ALLOW_FILE" | tr -s '[:space:]' '\n' | grep -E '^([0-9]+|\*)$' || true; }

cmd_templates() {
  api GET "/api/project/$SEMAPHORE_PROJECT/templates" | ALLOWED="$(allowed_ids | tr '\n' ' ')" python3 -c '
import json, os, sys
allowed = set(os.environ["ALLOWED"].split())
print("  * = may be started from here")
for t in sorted(json.load(sys.stdin), key=lambda t: t["id"]):
    mark = "*" if ("*" in allowed or str(t["id"]) in allowed) else " "
    print("%s %3d  %-32s %s" % (mark, t["id"], t["name"][:32], t["playbook"]))
'
}

cmd_recent() {
  api GET "/api/project/$SEMAPHORE_PROJECT/tasks/last" | N="${1:-15}" python3 -c '
import json, os, sys
for t in sorted(json.load(sys.stdin), key=lambda t: t["id"], reverse=True)[: int(os.environ["N"])]:
    print("%5d  %-9s %s  %s" % (t["id"], t.get("status", "?"), str(t.get("created", ""))[:16], t.get("tpl_alias", "")))
'
}

cmd_run() {
  local id=${1:?template id required}; shift
  local args="" why="started by semaphore-ctl" vars=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --var)  [[ ${2:?} =~ ^[A-Za-z_][A-Za-z0-9_]*=. ]] || die "--var expects name=value"; vars+=("$2"); shift 2 ;;
      --args) args=${2:?}; shift 2 ;;
      --why)  why=${2:?};  shift 2 ;;
      *) die "unknown option $1" ;;
    esac
  done
  [[ $id =~ ^[0-9]+$ ]] || die "template id must be a number"
  allowed_ids | grep -qxE "$id|\*" || die "template $id is not in $ALLOW_FILE - refusing to start it"
  # Semaphore drops the arguments of a task without saying so when its template does not allow them, and the playbook then runs
  # without the -e of a check-only run or of a restriction to some nodes.
  if [ -n "$args" ]; then
    api GET "/api/project/$SEMAPHORE_PROJECT/templates/$id" | python3 -c '
import json, sys
sys.exit(0 if json.load(sys.stdin).get("allow_override_args_in_task") else 1)
' || die "template $id does not allow arguments in a task (allow_override_args_in_task), so --args would be ignored: refusing to start it"
  fi
  local body
  # A template's survey variables travel as the task's extra variables: a JSON object inside a string.
  body=$(ID="$id" ARGS="$args" WHY="$why" python3 -c '
import json, os, sys
b = {"template_id": int(os.environ["ID"]), "message": os.environ["WHY"]}
if os.environ["ARGS"]:
    json.loads(os.environ["ARGS"])
    b["arguments"] = os.environ["ARGS"]
if len(sys.argv) > 1:
    b["environment"] = json.dumps(dict(v.split("=", 1) for v in sys.argv[1:]))
print(json.dumps(b))
' "${vars[@]}")
  api POST "/api/project/$SEMAPHORE_PROJECT/tasks" "$body" | python3 -c '
import json, sys
t = json.load(sys.stdin)
print("task %s started (template %s)" % (t["id"], t["template_id"]))
'
}

task_status() { api GET "/api/project/$SEMAPHORE_PROJECT/tasks/$1" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("status","?"))'; }

cmd_status() {
  api GET "/api/project/$SEMAPHORE_PROJECT/tasks/${1:?task id required}" | python3 -c '
import json, sys
t = json.load(sys.stdin)
print("task %s: %s  template=%s" % (t["id"], t.get("status"), t.get("tpl_alias", t.get("template_id"))))
print("  created %s  start %s  end %s" % (t.get("created"), t.get("start"), t.get("end")))
if t.get("message"): print("  message:", t["message"])
'
}

cmd_wait() {
  local id=${1:?task id required} limit=${2:-3000} waited=0 s
  while :; do
    s=$(task_status "$id")
    case "$s" in
      success) echo "task $id: success"; return 0 ;;
      error|stopped) echo "task $id: $s"; return 1 ;;
    esac
    [ "$waited" -ge "$limit" ] && { echo "task $id: still $s after ${limit}s"; return 2; }
    sleep 10; waited=$((waited + 10))
  done
}

cmd_log() {
  local id=${1:?task id required}; shift
  local mode=all n=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --errors) mode=errors; shift ;;
      --tail)   mode=tail; n=${2:?}; shift 2 ;;
      *) die "unknown option $1" ;;
    esac
  done
  api GET "/api/project/$SEMAPHORE_PROJECT/tasks/$id/output" | MODE="$mode" N="$n" python3 -c '
import json, os, re, sys
lines = [re.sub(r"\x1b\[[0-9;]*m", "", r["output"]) for r in json.load(sys.stdin)]
mode, n = os.environ["MODE"], int(os.environ["N"])
if mode == "tail":
    lines = lines[-n:]
elif mode == "errors":
    hit = [i for i, l in enumerate(lines) if re.search(r"^(fatal|FAILED|\[ERROR\]|ERROR)|failed=[1-9]|unreachable=[1-9]", l)]
    keep = set()
    for i in hit:
        keep.update(range(max(0, i - 6), min(len(lines), i + 8)))
    recap = [i for i, l in enumerate(lines) if "PLAY RECAP" in l]
    if recap: keep.update(range(recap[-1], len(lines)))
    lines = [lines[i] for i in sorted(keep)] or ["(no error lines found)"]
print("\n".join(lines))
'
}

# Creating a template or a schedule needs the Manager role on the project; the Task Runner role that
# starts tasks gets an HTTP 403 here. Nothing is ever edited or deleted.
cmd_schedules() {
  api GET "/api/project/$SEMAPHORE_PROJECT/schedules" | python3 -c '
import json, sys
for s in sorted(json.load(sys.stdin), key=lambda s: s["id"]):
    print("%3d  %-12s %-34s template %-3s %s" % (s["id"], s["cron_format"], s.get("name", "")[:34], s["template_id"], "" if s.get("active") else "(inactive)"))
'
}

# A new template is a copy of an existing one (same inventory, repository and variable group) with
# another name and playbook. The playbook must be a file of this repository, which the template can
# only run once it has been pushed.
cmd_copy_template() {
  local src=${1:?source template id required} name=${2:?new name required} playbook=${3:?playbook required} dry=0
  [ "${4:-}" = "--dry-run" ] && dry=1
  [[ $src =~ ^[0-9]+$ ]] || die "source template id must be a number"
  [[ $playbook =~ ^[A-Za-z0-9_.-]+\.yml$ ]] || die "the playbook must be the name of a file at the root of this repository"
  [ -f "$REPO_ROOT/$playbook" ] || die "$playbook is not a playbook of this repository"
  local body
  body=$(NAME="$name" PLAYBOOK="$playbook" TEMPLATES="$(api GET "/api/project/$SEMAPHORE_PROJECT/templates")" \
    SOURCE="$(api GET "/api/project/$SEMAPHORE_PROJECT/templates/$src")" python3 -c '
import json, os, sys
templates = json.loads(os.environ["TEMPLATES"])
if any(t["name"].lower() == os.environ["NAME"].lower() for t in templates):
    sys.exit("a template named %r already exists" % os.environ["NAME"])
source = json.loads(os.environ["SOURCE"])
keep = ("project_id", "inventory_id", "repository_id", "environment_id", "environment_ids", "view_id", "arguments",
        "description", "app", "type", "git_branch", "start_version", "survey_vars", "jwt_params", "task_params",
        "autorun", "allow_override_args_in_task", "allow_override_branch_in_task", "allow_parallel_tasks",
        "suppress_success_alerts", "runner_tag", "build_template_id", "vaults")
body = {k: source[k] for k in keep if k in source}
body.update(name=os.environ["NAME"], playbook=os.environ["PLAYBOOK"])
print(json.dumps(body))
') || exit 1
  if [ $dry -eq 1 ]; then echo "$body" | python3 -m json.tool; return 0; fi
  api POST "/api/project/$SEMAPHORE_PROJECT/templates" "$body" | python3 -c '
import json, sys
t = json.load(sys.stdin)
print("template %s created: %s (%s)" % (t["id"], t["name"], t["playbook"]))
'
}

cmd_set_schedule() {
  local id=${1:?schedule id required} cron=${2:?cron expression required} dry=0
  [ "${3:-}" = "--dry-run" ] && dry=1
  [[ $id =~ ^[0-9]+$ ]] || die "schedule id must be a number"
  [[ $cron =~ ^([0-9*/,-]+\ ){4}[0-9*/,-]+$ ]] || die "'$cron' is not a five-field cron expression"
  local current body
  current=$(api GET "/api/project/$SEMAPHORE_PROJECT/schedules/$id")
  body=$(CURRENT="$current" CRON="$cron" python3 -c '
import json, os
s = json.loads(os.environ["CURRENT"])
s["cron_format"] = os.environ["CRON"]
print(json.dumps(s))
')
  if [ $dry -eq 1 ]; then echo "$body" | python3 -m json.tool; return 0; fi
  api PUT "/api/project/$SEMAPHORE_PROJECT/schedules/$id" "$body" > /dev/null
  echo "schedule $id now runs at: $cron"
}

cmd_add_schedule() {
  local id=${1:?template id required} cron=${2:?cron expression required} name=${3:?name required} dry=0
  [ "${4:-}" = "--dry-run" ] && dry=1
  [[ $id =~ ^[0-9]+$ ]] || die "template id must be a number"
  [[ $cron =~ ^([0-9*/,-]+\ ){4}[0-9*/,-]+$ ]] || die "'$cron' is not a five-field cron expression"
  local body
  body=$(ID="$id" CRON="$cron" NAME="$name" PROJECT="$SEMAPHORE_PROJECT" python3 -c '
import json, os
print(json.dumps({"template_id": int(os.environ["ID"]), "project_id": int(os.environ["PROJECT"]), "cron_format": os.environ["CRON"],
                  "name": os.environ["NAME"], "active": True, "type": "", "delete_after_run": False}))
')
  if [ $dry -eq 1 ]; then echo "$body" | python3 -m json.tool; return 0; fi
  api POST "/api/project/$SEMAPHORE_PROJECT/schedules" "$body" | python3 -c '
import json, sys
s = json.load(sys.stdin)
print("schedule %s created: %s, template %s" % (s["id"], s["cron_format"], s["template_id"]))
'
}

cmd_delete_schedule() {
  local id=${1:?schedule id required} dry=0
  [ "${2:-}" = "--dry-run" ] && dry=1
  [[ $id =~ ^[0-9]+$ ]] || die "schedule id must be a number"
  api GET "/api/project/$SEMAPHORE_PROJECT/schedules/$id" | python3 -c '
import json, sys
s = json.load(sys.stdin)
print("schedule %s: %s, template %s, %s" % (s["id"], s["cron_format"], s["template_id"], s.get("name", "")))
'
  [ $dry -eq 1 ] && return 0
  api DELETE "/api/project/$SEMAPHORE_PROJECT/schedules/$id" > /dev/null
  echo "schedule $id deleted"
}

cmd_rename_template() {
  local id=${1:?template id required} name=${2:?new name required} dry=0
  [ "${3:-}" = "--dry-run" ] && dry=1
  [[ $id =~ ^[0-9]+$ ]] || die "template id must be a number"
  local body
  body=$(NAME="$name" TEMPLATES="$(api GET "/api/project/$SEMAPHORE_PROJECT/templates")" \
    CURRENT="$(api GET "/api/project/$SEMAPHORE_PROJECT/templates/$id")" python3 -c '
import json, os, sys
t = json.loads(os.environ["CURRENT"])
if any(o["name"].lower() == os.environ["NAME"].lower() and o["id"] != t["id"] for o in json.loads(os.environ["TEMPLATES"])):
    sys.exit("a template named %r already exists" % os.environ["NAME"])
t["name"] = os.environ["NAME"]
print(json.dumps(t))
') || exit 1
  if [ $dry -eq 1 ]; then echo "$body" | python3 -m json.tool; return 0; fi
  api PUT "/api/project/$SEMAPHORE_PROJECT/templates/$id" "$body" > /dev/null
  echo "template $id renamed to: $name"
}
cmd_rename_schedule() {
  local id=${1:?schedule id required} name=${2:?new name required} dry=0
  [ "${3:-}" = "--dry-run" ] && dry=1
  [[ $id =~ ^[0-9]+$ ]] || die "schedule id must be a number"
  local body
  body=$(NAME="$name" CURRENT="$(api GET "/api/project/$SEMAPHORE_PROJECT/schedules/$id")" python3 -c '
import json, os
s = json.loads(os.environ["CURRENT"])
s["name"] = os.environ["NAME"]
print(json.dumps(s))
')
  if [ $dry -eq 1 ]; then echo "$body" | python3 -m json.tool; return 0; fi
  api PUT "/api/project/$SEMAPHORE_PROJECT/schedules/$id" "$body" > /dev/null
  echo "schedule $id renamed to: $name"
}
cmd_delete_template() {
  local id=${1:?template id required} dry=0
  [ "${2:-}" = "--dry-run" ] && dry=1
  [[ $id =~ ^[0-9]+$ ]] || die "template id must be a number"
  api GET "/api/project/$SEMAPHORE_PROJECT/templates/$id" | python3 -c '
import json, sys
t = json.load(sys.stdin)
print("template %s: %s, playbook %s" % (t["id"], t["name"], t["playbook"]))
'
  [ $dry -eq 1 ] && return 0
  api DELETE "/api/project/$SEMAPHORE_PROJECT/templates/$id" > /dev/null
  echo "template $id deleted"
}

# environments - the variable groups of the project, with the NAMES of their variables and secrets, never a value. The list
# endpoint leaves the secrets out, so each group is read on its own.
cmd_environments() {
  local id
  for id in $(api GET "/api/project/$SEMAPHORE_PROJECT/environment" | python3 -c 'import json, sys; print(" ".join(str(e["id"]) for e in sorted(json.load(sys.stdin), key=lambda e: e["id"])))'); do
    api GET "/api/project/$SEMAPHORE_PROJECT/environment/$id" | python3 -c '
import json, sys
e = json.load(sys.stdin)
env = json.loads(e.get("env") or "{}")
extra = json.loads(e.get("json") or "{}")
secrets = ["%s (%s)" % (x["name"], x["type"]) for x in e.get("secrets") or []]
print("environment %s: %s" % (e["id"], e["name"]))
print("  environment variables: %s" % (", ".join(sorted(env)) or "-"))
print("  extra variables:       %s" % (", ".join(sorted(extra)) or "-"))
print("  secrets:               %s" % (", ".join(sorted(secrets)) or "-"))
'
  done
}

# delete-env-secret <environment-id> <name> [--dry-run] - removes one secret of a variable group by its name, nothing else of the
# group changes. It shows what it is about to remove first, and --dry-run stops there. The value of a secret is never read.
cmd_delete_env_secret() {
  local id=${1:?environment id required} name=${2:?secret name required} dry=0
  [ "${3:-}" = "--dry-run" ] && dry=1
  [[ $id =~ ^[0-9]+$ ]] || die "environment id must be a number"
  [[ $name =~ ^[A-Za-z0-9_]+$ ]] || die "secret name must be letters, digits and underscores"
  local body
  body=$(api GET "/api/project/$SEMAPHORE_PROJECT/environment/$id" | ENV_ID=$id SECRET=$name python3 -c '
import json, os, sys
e = json.load(sys.stdin)
match = [x for x in e.get("secrets") or [] if x["name"] == os.environ["SECRET"]]
if len(match) != 1:
    sys.exit("semaphore-ctl: no single secret named %s in environment %s" % (os.environ["SECRET"], os.environ["ENV_ID"]))
x = match[0]
print(json.dumps({"id": e["id"], "name": e["name"], "project_id": e["project_id"], "json": e.get("json") or "{}", "env": e.get("env") or "{}",
                  "secrets": [{"id": x["id"], "name": x["name"], "type": x["type"], "operation": "delete"}]}))
') || exit 1
  echo "environment $id: will remove the secret $name ($(printf '%s' "$body" | python3 -c 'import json, sys; print(json.load(sys.stdin)["secrets"][0]["type"])'))"
  [ $dry -eq 1 ] && return 0
  api PUT "/api/project/$SEMAPHORE_PROJECT/environment/$id" "$body" > /dev/null
  echo "secret $name removed from environment $id"
}

case "${1:-}" in
  templates) shift; cmd_templates "$@" ;;
  recent)    shift; cmd_recent "$@" ;;
  run)       shift; cmd_run "$@" ;;
  status)    shift; cmd_status "$@" ;;
  wait)      shift; cmd_wait "$@" ;;
  log)       shift; cmd_log "$@" ;;
  schedules) shift; cmd_schedules "$@" ;;
  copy-template) shift; cmd_copy_template "$@" ;;
  add-schedule)  shift; cmd_add_schedule "$@" ;;
  set-schedule)  shift; cmd_set_schedule "$@" ;;
  delete-schedule) shift; cmd_delete_schedule "$@" ;;
  delete-template) shift; cmd_delete_template "$@" ;;
  rename-template) shift; cmd_rename_template "$@" ;;
  rename-schedule) shift; cmd_rename_schedule "$@" ;;
  environments) shift; cmd_environments "$@" ;;
  delete-env-secret) shift; cmd_delete_env_secret "$@" ;;
  *) sed -n '2,19p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
