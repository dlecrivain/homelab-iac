#!/usr/bin/env python3
"""Keeps the client credentials of a workstation from expiring: the talosconfig and the admin kubeconfig of the cluster.

    renew-client-credentials [--talosconfig FILE] [--kubeconfig FILE] [--days 90] [--ttl 43800h] [--check] [--daily] [--quiet]

The certificate of each file is read, and the ones that end within --days are replaced by a new one that the cluster issues: the
talosconfig with `talosctl config new` (valid --ttl, five years by default), the kubeconfig with `talosctl kubeconfig` (valid a year,
which is what Talos issues). Only the certificate and its key are replaced: the names, the endpoints and the rest of the file stay as
they were. The new file is tried against the cluster before it takes the place of the old one, which stays next to it as FILE.previous.

  --check    only report the date each certificate ends
  --daily    do nothing when this ran less than a day ago, so that it can be started by every terminal (see env.sh)
  --quiet    print something only when a certificate was renewed or when it failed
"""
import argparse
import base64
import datetime
import os
import shutil
import subprocess
import sys
import tempfile
import time

import yaml

_MONTHS = {m: i for i, m in enumerate(["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"], 1)}
_STAMP = os.path.expanduser("~/.cache/renew-client-credentials.stamp")


class Failure(Exception):
    pass


def run(*command):
    result = subprocess.run(command, capture_output=True, text=True)
    if result.returncode != 0:
        first = (result.stderr.strip().splitlines() or ["no message"])[0]
        raise Failure("%s: %s" % (" ".join(command[:3]), first))
    return result.stdout


def ends(certificate_b64):
    """When a base64 PEM certificate ends (UTC), as the date that openssl prints, which does not depend on the language."""
    pem = base64.b64decode(certificate_b64)
    out = subprocess.run(["openssl", "x509", "-noout", "-enddate"], input=pem, capture_output=True)
    if out.returncode != 0:
        raise Failure("openssl cannot read the certificate")
    month, day, clock, year = out.stdout.decode().split("=", 1)[1].split()[:4]
    hour, minute, second = clock.split(":")
    return datetime.datetime(int(year), _MONTHS[month], int(day), int(hour), int(minute), int(second))


def load(path):
    with open(path) as f:
        return yaml.safe_load(f)


def save(path, document, mode=0o600):
    descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, mode)
    with os.fdopen(descriptor, "w") as f:
        yaml.safe_dump(document, f, default_flow_style=False)


def talos_pair(document):
    context = document["contexts"][document["context"]]
    return context, "crt", "key"


def kube_pair(document):
    user = document["users"][0]["user"]
    return user, "client-certificate-data", "client-key-data"


def install(path, document, test):
    """Write the new document next to the old one, try it, keep the old one as FILE.previous and put the new one in its place."""
    directory = tempfile.mkdtemp(prefix=".renew-", dir=os.path.dirname(path))
    try:
        candidate = os.path.join(directory, "candidate")
        save(candidate, document)
        test(candidate)
        shutil.copy2(path, path + ".previous")
        os.replace(candidate, path)
    finally:
        shutil.rmtree(directory, ignore_errors=True)


def renew_talosconfig(path, ttl):
    directory = tempfile.mkdtemp(prefix=".renew-", dir=os.path.dirname(path))
    try:
        fresh = os.path.join(directory, "fresh")
        run("talosctl", "--talosconfig", path, "config", "new", fresh, "--roles", "os:admin", "--crt-ttl", ttl)
        new = load(fresh)
    finally:
        shutil.rmtree(directory, ignore_errors=True)
    document = load(path)
    old_part, crt, key = talos_pair(document)
    new_part = next(iter(new["contexts"].values()))
    before = ends(old_part[crt])
    old_part[crt], old_part[key] = new_part[crt], new_part[key]
    install(path, document, lambda candidate: run("talosctl", "--talosconfig", candidate, "version"))
    return before


def renew_kubeconfig(path, talosconfig):
    directory = tempfile.mkdtemp(prefix=".renew-", dir=os.path.dirname(path))
    try:
        fresh = os.path.join(directory, "fresh")
        run("talosctl", "--talosconfig", talosconfig, "kubeconfig", fresh, "--merge=false", "--force")
        new = load(fresh)
    finally:
        shutil.rmtree(directory, ignore_errors=True)
    document = load(path)
    old_part, crt, key = kube_pair(document)
    new_part = kube_pair(new)[0]
    before = ends(old_part[crt])
    old_part[crt], old_part[key] = new_part[crt], new_part[key]
    install(path, document, lambda candidate: run("kubectl", "--kubeconfig", candidate, "get", "--raw", "/readyz"))
    return before


def main():
    parser = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    parser.add_argument("--talosconfig", default=os.environ.get("TALOSCONFIG") or "~/.config/talos/maquette/talosconfig")
    parser.add_argument("--kubeconfig", default=(os.environ.get("KUBECONFIG") or "~/.kube/maquette.yaml").split(":")[0])
    parser.add_argument("--days", type=int, default=90)
    parser.add_argument("--ttl", default="43800h")
    parser.add_argument("--check", action="store_true")
    parser.add_argument("--daily", action="store_true")
    parser.add_argument("--quiet", action="store_true")
    args = parser.parse_args()
    talosconfig, kubeconfig = os.path.expanduser(args.talosconfig), os.path.expanduser(args.kubeconfig)

    if args.daily and os.path.exists(_STAMP) and time.time() - os.path.getmtime(_STAMP) < 86400:
        return 0
    say = (lambda text: None) if args.quiet else print
    now = datetime.datetime.now(datetime.timezone.utc).replace(tzinfo=None)
    problems = []
    for name, path, pair, renew in (
        ("talosconfig", talosconfig, talos_pair, lambda: renew_talosconfig(talosconfig, args.ttl)),
        ("kubeconfig", kubeconfig, kube_pair, lambda: renew_kubeconfig(kubeconfig, talosconfig)),
    ):
        try:
            if not os.path.exists(path):
                say("%s: %s is not there, nothing to renew" % (name, path))
                continue
            part, crt, _ = pair(load(path))
            end = ends(part[crt])
            left = (end - now).days
            if left >= args.days:
                say("%s ends on %s (%d days): nothing to do" % (name, end.date(), left))
            elif args.check:
                say("%s ends on %s (%d days): would be renewed" % (name, end.date(), left))
            else:
                before = renew()
                part, crt, _ = pair(load(path))
                print("%s renewed: it ended on %s, the new one ends on %s" % (name, before.date(), ends(part[crt]).date()))
        except (Failure, OSError, KeyError, IndexError, yaml.YAMLError) as error:
            problems.append("%s: %s" % (name, error))
    if problems:
        message = "client credentials not renewed:\n  " + "\n  ".join(problems)
        print(message, file=sys.stderr)
        if shutil.which("notify-send"):
            subprocess.run(["notify-send", "renew-client-credentials", message], check=False)
        return 1
    if args.daily:
        os.makedirs(os.path.dirname(_STAMP), exist_ok=True)
        open(_STAMP, "w").close()
    return 0


if __name__ == "__main__":
    sys.exit(main())
